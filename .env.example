# Lidas pelo Vite em tempo de build; só variáveis com prefixo VITE_ chegam ao navegador.

# URLs dos serviços consumidos pela vitrine (CONTRATOS.md, seção 1)
VITE_CATALOG_URL=http://localhost:3001
VITE_ORDERS_URL=http://localhost:3002
VITE_AUTH_URL=http://localhost:3003

# true substitui o cliente HTTP por dados fixos em src/services/mock/
# Conta de demonstração nesse modo: ana@varal.dev / varal123
VITE_USE_MOCKS=false
